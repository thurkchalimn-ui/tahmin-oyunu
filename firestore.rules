rules_version = '2';

// Güvenlik notu: Seri (streak) yeniden hesaplama işlemi bu MVP'de admin
// istemcisi tarafından tetiklenir. Üretimde kopyalanamaz/hile yapılamaz
// olması için bu mantığın bir Cloud Function'a taşınması önerilir
// (bkz. proje README'sindeki "Sonraki Geliştirme Adımı").
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // admins koleksiyonu: sadece Firebase Console üzerinden manuel eklenir,
    // istemciden asla yazılamaz.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // users/{uid}: herkes liderlik tablosu için okuyabilir.
    // Sahibi displayName, avatar, bildirim tercihleri ve aktiflik/rozet/XP
    // alanlarını günceller; seri (streak) alanlarını yalnız admin değiştirir.
    // GÜVENLİK NOTU: 'badges' ve 'xp' alanları sahibi tarafından yazılabilir
    // olduğu için (activityStreak/correctTotal rozetlerinin ve XP'nin istemci
    // tarafında hesaplanıp verilmesi gerektiğinden), teorik olarak bir
    // kullanıcı kendine sahte bir rozet/XP yazabilir. Bu, düşük riskli/kozmetik
    // bir özellik olduğu için MVP'de kabul edilmiştir; tam sunucu taraflı
    // doğrulama bir Cloud Function gerektirir (bkz. bu dosyanın başındaki
    // benzer not).
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt', 'lastSeenChatAt', 'lastSeenRank', 'lastSeenProfileAt', 'fcmTokens', 'avatarUrl', 'notifyOnResult', 'notifyOnReminder', 'lastActiveAt', 'activityStreak', 'lastActiveDateKey', 'badges', 'xp', 'socialFollowClaimed'])) ||
        // Davet linkiyle kayıt olan kullanıcı, davet edeni SADECE BİR KEZ
        // (henüz hiç ayarlanmamışsa) kaydedebilir - sonradan değiştirilemez,
        // böylece kayıt sonrası referansı manipüle etmek mümkün olmaz.
        (isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedByUid']) &&
          resource.data.invitedByUid == null &&
          request.resource.data.invitedByUid is string);
      allow delete: if isOwner(uid);
    }

    // usernames/{normalizedName}: kullanıcı adı benzersizliğinin GERÇEK garantisi
    // burada sağlanır. Doküman ID'si normalize edilmiş kullanıcı adıdır - bir isim
    // zaten alınmışsa doküman zaten var demektir, bu durumda "create" değil "update"
    // kuralına düşer ve `allow update: if false` bunu otomatik olarak engeller.
    // Böylece iki kullanıcı aynı anda aynı ismi almaya çalışsa bile sadece biri başarılı olur.
    match /usernames/{key} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.uid);
      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    // follows/{followerUid}_{followedUid}: tek yönlü takip sistemi (Twitter
    // tarzı - karşı taraf onayı gerekmez). Herkes okuyabilir (takipçi/takip
    // sayıları herkese açık); sadece kendi takip kaydını oluşturabilir/silebilir.
    match /follows/{followId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.followerUid);
      allow update: if false;
      allow delete: if isOwner(resource.data.followerUid);
    }

    // duels/{id}: arkadaşlar arası 1v1 tahmin düellosu. Meydan okuyan
    // (challengerUid) daveti oluşturur; sadece rakip (opponentUid) daveti
    // kabul/red edebilir (status günceller). Sonuç hesaplaması (score,
    // winnerUid) SADECE otomasyon script'i (Admin SDK, kuralları bypass eder)
    // tarafından yazılır - istemci bu alanları asla değiştiremez, aksi halde
    // bir kullanıcı kendini kazanan ilan edebilirdi.
    match /duels/{duelId} {
      allow read: if isOwner(resource.data.challengerUid) || isOwner(resource.data.opponentUid);
      allow create: if isOwner(request.resource.data.challengerUid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.opponentUid != request.resource.data.challengerUid;
      allow update: if isOwner(resource.data.opponentUid) &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
        (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined');
      allow delete: if false;
    }

    // leagues/{leagueId}: kullanıcıların kurduğu özel (arkadaş grubu) ligler.
    // Sadece üyeler görebilir (gizlilik amaçlı); sadece kurucu üye ekleyip
    // çıkarabilir ve ligi silebilir. Kurucu, kendini oluşturma anında üye
    // listesine eklemek ZORUNDADIR.
    match /leagues/{leagueId} {
      allow read: if isSignedIn() &&
        (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.memberUids);
      allow create: if isOwner(request.resource.data.ownerUid) &&
        request.auth.uid in request.resource.data.memberUids;
      allow update: if isOwner(resource.data.ownerUid);
      allow delete: if isOwner(resource.data.ownerUid);
    }

    // matches/{matchId}: herkes okuyabilir, sadece admin yazar/düzenler.
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // teamLogos/{normalizedTeamName}: daha önce eklenmiş takımların logo
    // hafızası. Admin panelindeki "takım adı yazınca logo otomatik gelsin"
    // özelliği için kullanılır; herkes okuyabilir, sadece admin yazar.
    match /teamLogos/{teamKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // avatarOptions/{key}: admin tarafından belirlenen, kullanıcıların profil
    // avatarı olarak seçebileceği sabit logo listesi. Kullanıcılar sadece bu
    // listeden seçer, kendi görsel linki giremez; herkes okuyabilir, sadece admin yazar.
    match /avatarOptions/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // leaderboardCache/{period}: haftalık/aylık liderlik tablosunun ÖNCEDEN
    // HESAPLANMIŞ hali. Otomasyon script'i (automation/check-results.js, Admin
    // SDK ile - kural bypass eder) bunu her ~6 saatte bir günceller. İstemciden
    // asla yazılamaz, sadece okunabilir - böylece her sayfa açılışında pahalı
    // bir hesaplama tekrarlanmaz.
    match /leaderboardCache/{period} {
      allow read: if true;
      allow write: if false;
    }

    // notificationQueue/{id}: admin panelinden elle bir maç sonucu girildiğinde
    // buraya bir "gönderilmesi gereken bildirim" kaydı bırakılır. İstemci
    // doğrudan başka bir kullanıcıya push gönderemediği için gerçek gönderim,
    // Admin SDK'ya sahip GitHub Actions otomasyon script'i tarafından yapılır
    // (bkz. automation/check-results.js) - o da bu koleksiyonu okuyup temizler.
    match /notificationQueue/{id} {
      allow read: if false;
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // notifications/{id}: uygulama içi bildirim merkezi (zil ikonu). Bu,
    // notificationQueue'dan (SADECE push gönderimi için, admin/otomasyon
    // tarafından oluşturulan, kalıcı olmayan bir kuyruk) FARKLI - burası
    // kullanıcının kendi bildirim GEÇMİŞİ, kalıcı olarak saklanır.
    // ÖNEMLİ: create izni herhangi bir giriş yapmış kullanıcıya açık, çünkü
    // bildirimler doğası gereği "başkası için" oluşturulur (ör. birini takip
    // ettiğinde ona bildirim düşer, admin bir maç sonucu girdiğinde etkilenen
    // kullanıcılara bildirim düşer - bu işlemi yapan kişi bildirimin SAHİBİ
    // değildir). read/update/delete ise sadece bildirimin sahibine açık -
    // gizlilik burada korunuyor.
    match /notifications/{id} {
      allow read: if isOwner(resource.data.userId);
      allow create: if request.auth != null && request.resource.data.userId is string;
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isOwner(resource.data.userId);
    }

    // predictions/{predictionId}: kullanıcı sadece kendi tahminini,
    // maç henüz kilitlenmemişken (kickoffAt gelecekte) VE e-postasını
    // doğrulamışken oluşturabilir. isCorrect alanı yalnız admin tarafından
    // (sonuç girildiğinde) güncellenir.
    // GÜVENLİK NOTU: Günlük tahmin hakkı limiti (5 ücretsiz + reklamla kazanılan
    // bonus, en fazla 20) bu MVP'de yalnızca istemci tarafında (arayüzde)
    // uygulanmaktadır. Tam sunucu taraflı doğrulama bir Cloud Function/transaction
    // gerektirir; bkz. bu dosyanın başındaki benzer not (seri hesaplaması için).
    match /predictions/{predictionId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.isCorrect == null &&
        request.resource.data.date is string &&
        request.auth.token.email_verified == true;
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.userId); // Hesap silme akışında kullanıcı kendi tahminlerini kaldırabilir
    }

    // dailyBonusCredits/{uid}_{date}: kullanıcı, reklam izleyerek kazandığı
    // günlük ekstra tahmin hakkını burada biriktirir. Her yazımda tam olarak
    // +1 artabilir ve en fazla 15'e (5 temel hak + 15 = 20 tavan) ulaşabilir;
    // böylece bir kullanıcı isteği manipüle etse bile sınırsız hak biriktiremez.
    match /dailyBonusCredits/{docId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.userId) &&
        request.resource.data.credits == 1;
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.credits == resource.data.credits + 1 &&
        request.resource.data.credits <= 15;
      allow delete: if false;
    }
    // messages/{messageId}: herkes okuyabilir (giriş yapmasa bile), sadece
    // e-postasını doğrulamış kullanıcılar kendi adına mesaj gönderebilir.
    // Mesajlar bir kez gönderildikten sonra değiştirilemez/silinemez (moderasyon
    // gerekirse admin panelinden Firestore Console üzerinden manuel silinebilir).
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.userId) &&
        request.auth.token.email_verified == true &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.isAdmin == isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
